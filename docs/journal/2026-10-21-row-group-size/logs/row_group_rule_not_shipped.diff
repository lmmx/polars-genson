+/// (Row group, leaf column) chunks wanted per thread
+const CHUNKS_PER_THREAD: usize = 4;
+
+/// The fewest rows a row group is cut down to
+const MIN_ROW_GROUP_ROWS: usize = 128 * 1024;
+
+/// Rows per row group for `batches`: arrow-rs's 1Mi, or fewer (down to 128Ki) until the
+/// table has [`CHUNKS_PER_THREAD`] column chunks per thread. `write_batches` encodes each
+/// column chunk on one thread, so a table of few leaf columns in few row groups leaves
+/// threads idle: 2.5M rows of one list column made 3 chunks for 4 threads, and wrote in
+/// 0.76 s at 1Mi-row row groups against 0.57 s at 128Ki. Tables that already have enough
+/// chunks keep 1Mi-row row groups. Smaller ones gained nothing there, and cost
+/// dictionary-encoded columns a dictionary per row group: 4 to 5% larger files and 8 to
+/// 14% more CPU on the graded tables (docs/journal/2026-10-21-row-group-size.md).
+fn row_group_rows(schema: &SchemaRef, spec_names: bool, batches: &[RecordBatch]) -> usize {
+    let leaves = parquet::arrow::ArrowSchemaConverter::new()
+        .with_coerce_types(spec_names)
+        .convert(schema)
+        .map_or(schema.fields().len(), |descr| descr.num_columns())
+        .max(1);
+    let rows: usize = batches.iter().map(RecordBatch::num_rows).sum();
+    let groups = (CHUNKS_PER_THREAD * rayon::current_num_threads()).div_ceil(leaves);
+    rows.div_ceil(groups)
+        .clamp(MIN_ROW_GROUP_ROWS, DEFAULT_MAX_ROW_GROUP_ROW_COUNT)
+}
