+#[test]
+fn test_narrow_tables_get_row_groups_for_every_thread() {
+    // 2 columns on 4 threads want 8 row groups: 37,500 rows, raised to the 128Ki minimum
+    assert_eq!(row_groups_of(2), vec![131_072, 131_072, 37_856]);
+    // 16 columns fill 4 threads 4 times over in one row group
+    assert_eq!(row_groups_of(16), vec![300_000]);
+}
