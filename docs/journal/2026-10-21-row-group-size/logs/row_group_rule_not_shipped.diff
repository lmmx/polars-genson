+/// Written on 4 threads, `columns` Int64 columns of 300,000 rows (in batches that straddle
+/// the row group boundaries) read back unchanged; returns the rows of each row group.
+fn row_groups_of(columns: usize) -> Vec<i64> {
+    use arrow::array::{Int64Array, StructArray};
+    use arrow::datatypes::Fields;
+    let rows = 300_000;
+    let values = Int64Array::from_iter_values(0..rows as i64);
+    let fields: Fields = (0..columns).map(|i| Field::new(format!("c{i}"), DataType::Int64, true)).collect();
+    let batches: Vec<StructArray> = (0..rows)
+        .step_by(70_000)
+        .map(|start| {
+            let slice: ArrayRef = Arc::new(values.slice(start, 70_000.min(rows - start)));
+            StructArray::new(fields.clone(), vec![slice; columns], None)
+        })
+        .collect();
+    let file = NamedTempFile::new().unwrap();
+    let layout = StructLayout { unnest: true, spec_names: true };
+    let pool = rayon::ThreadPoolBuilder::new().num_threads(4).build().unwrap();
+    pool.install(|| write_struct_columns(file.path().to_str().unwrap(), "x", batches, &fields, &[], None, layout))
+        .unwrap();
+
+    let builder = ParquetRecordBatchReaderBuilder::try_new(File::open(file.path()).unwrap()).unwrap();
+    let group_rows = builder.metadata().row_groups().iter().map(|g| g.num_rows()).collect();
+    let read: Vec<_> = builder.build().unwrap().map(|b| b.unwrap()).collect();
+    let read = arrow::compute::concat_batches(&read[0].schema(), &read).unwrap();
+    for column in read.columns() {
+        assert_eq!(column.as_any().downcast_ref::<Int64Array>().unwrap(), &values);
+    }
+    group_rows
+}
